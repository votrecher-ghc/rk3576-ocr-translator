{
  "app": {
    "mode": "live",
    "log_level": "info",
    "log_file": "/var/log/ocr_translator.log"
  },
  "capture": {
    "device": "/dev/video0",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "format": "NV12",
    "buffer_count": 4
  },
  "display": {
    "device": "/dev/dri/card0",
    "display_width": 1280,
    "display_height": 720
  },
  "ai": {
    "det_model": "/usr/share/ocr/models/ppocrv4_det_int8.rknn",
    "rec_model": "/usr/share/ocr/models/ppocrv4_rec_fp16.rknn",
    "rec_vocab": "/usr/share/ocr/models/ppocr_keys_v1.txt",
    "trans_encoder_model": "/usr/share/ocr/models/lite_transformer_encoder_fp16.rknn",
    "trans_decoder_model": "/usr/share/ocr/models/lite_transformer_decoder_fp16.rknn",
    "trans_manifest": "/usr/share/ocr/models/translation_manifest.json",
    "src_vocab": "/usr/share/ocr/models/translation_src_vocab.txt",
    "tgt_vocab": "/usr/share/ocr/models/translation_tgt_vocab.txt",
    "det_threshold": 0.3,
    "det_box_threshold": 0.6,
    "allow_ocr_only": false,
    "src_lang": "en",
    "dst_lang": "zh"
  },
  "stab": {
    "imu_device": "auto",
    "sample_rate": 1000,
    "crop_ratio": 0.833333,
    "filter_beta": 0.1,
    "madgwick_beta": 0.1
  },
  "sensors": {
    "ambient_light_device": "auto",
    "temperature_device": "auto",
    "backlight_path": "/sys/class/backlight/panel-backlight/brightness",
    "pwm_fan_path": "kernel"
  },
  "input": {
    "key_device": "auto"
  },
  "archive": {
    "base_dir": "/data/ocr",
    "max_usage_pct": 90,
    "jpeg_quality": 90
  }
}
